 *   (b) list the original authors (as listed in the copyright at the top of
 *       this license)
 * 
 * When sharing binaries, you must adhere to a few more rules. Either:
 * 
 *   (a) your derivative work differs sufficiently from the original or
 *   (b) you have received written permission from all Project Owners
 * 
 * <title> is distributed in the hope that it will be useful, but WITHOUT
 * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
 * FITNESS FOR A PARTICULAR PURPOSE. See the MCOML for more details.
 * 
 * You should have received a copy of the MCOML along with <title>.
 * If not, see <https://gitlab.com/srcmc/mcoml/-/blob/main/v1/license.txt>.
 */"

# parse arguments
case "$1" in
    ARR|arr)
        full="$ARR_FULL"
        header="$ARR_HEADER" ;;
    MIT|mit)
        full="$MIT_FULL"
        header="$MIT_HEADER" ;;
    LGPL3|lgpl3)
        full="$LGPL3_FULL"
        header="$LGPL3_HEADER" ;;
    MCOML|mcoml)
        full="$MCOML_FULL"
        header="$MCOML_HEADER" ;;
    *)
        echo "error: invalid license '$1'"
        exit 1 ;;
esac

if [ -z "$2" ]; then
    echo "error: missing title"
    exit 1
fi

if [ -z "$3" ]; then
    echo "error: missing author"
    exit 1
fi

title="$2"
author="$3"
NL='
'

shift
shift
shift

# add license header to source files
while [ "$#" -gt 0 ]; do
    if [ -f "$1" ]; then
        line="$(head "$1" -n 1)"

        if [ "$line" == '/*' ]; then
            while IFS="" read -r p || [ -n "$p" ]; do
                if [ -z "$first" ]; then
                    first=1
                else
                    if [ -n "$accept" ]; then
                        content="${content:+$content$NL}$p"
                    else
                        if [ "${p:0:3}" == " */" ]; then
                            accept=1
                        elif [ "${p:0:2}" != " *" ]; then
                            content="$(cat "$1")"
                            break;
                        fi
                    fi
                fi
            done < "$1"
        else
            content="$(cat "$1")"
        fi

        if [ -n "$header" ]; then
            echo "$(echo "$header" | sed -e s/"<title>"/"$title"/g -e s/"<author>"/"$author"/g)" > "$1"
            echo "$content" >> "$1"
        else
            echo "$content" > "$1"
        fi

        unset first
        unset accept
        unset content
    else
        echo "warning: invalid file '$1' -> skipped"
    fi

    shift
done

# remove existing license files
if [ -n "$LICENSE_FILES_OLD" ]; then
    rm -f $LICENSE_FILES_OLD
fi

# create license file with full text
if [ -n "$LICENSE_FILE" ]; then
    echo "$(echo "$full" | sed -e s/"<title>"/"$title"/g -e s/"<author>"/"$author"/g)" > "$LICENSE_FILE"
fi
