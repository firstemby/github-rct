#!/bin/bash
#
# This script prepends predefined licence headers into java source files. Existing
# headers are recognized by the start of java block comments (/*) at the beggining
# of file and will be replaced.
#
# The path to a license file to store the full license text can be defined with
# LICENSE_FILE (no license file will be created if empty).
#
# The script will initially attempt to remove existing license files specified by
# LICENSE_FILES_OLD (no files will be removed if empty).
#
# usage: licensify <license> <title> <author> <files>...

