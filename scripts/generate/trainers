#!/bin/bash

## Dependencies
# - rcttrp installed - https://gitlab.com/srcmc/rct/rcttrp

## Config
RADICALRED_SOURCE=${RADICALRED_SOURCE:-"https://gitlab.com/srcmc/rct/rcttrp/-/raw/master/dumps/radical_red_3_02_trainers.txt?ref_type=heads"}
BDSP_SOURCE=${BDSP_SOURCE:-"https://gitlab.com/srcmc/rct/rcttrp/-/raw/master/dumps/bdsp_1_1.csv?ref_type=heads"}
UNBOUND_SOURCE=${UNBOUND_SOURCE:-"https://gitlab.com/srcmc/rct/rcttrp/-/raw/master/dumps/unbound_2_0_3_2_modified.txt?ref_type=heads"}
OUT="common/src/main/resources/data/rctmod/trainers"

echo -e "\033[2J\033[2;1HEnter radicalred source (leave empty for default '$RADICALRED_SOURCE')"
read -p "Path: " answer
echo "==============================="
RADICALRED_SOURCE=${answer:-$RADICALRED_SOURCE}

echo "Enter bdsp source (leave empty for default '$BDSP_SOURCE')"
read -p "Path: " answer
echo "==============================="
BDSP_SOURCE=${answer:-$BDSP_SOURCE}

echo "Enter unbound source (leave empty for default '$UNBOUND_SOURCE')"
read -p "Path: " answer
echo "==============================="
UNBOUND_SOURCE=${answer:-$UNBOUND_SOURCE}

echo "Enter output path (leave empty for default '$OUT')"
read -p "Path: " answer
echo "==============================="
OUT=${answer:-$OUT}

if [ -d "$OUT" ]; then
    unset answer

    while [ 1 ]; do
        echo -e "Output directory '$OUT' already exists!"
        read -p "Continue and remove it [y/n]?: " answer

        case "$answer" in
            y|Y|yes|YES)
                echo "==============================="
                break ;;
            n|N|no|NO)
                echo "Operation canceled"
                exit 0 ;;
        esac

        echo -e "\033[A\033[2K\033[A\033[2K\033[A" # clear last 2 lines
    done
fi

## Commands
rm -rf "$OUT" && \
mkdir -p "$OUT" && \
rcttrp -out "$OUT" -parse-radicalred "$RADICALRED_SOURCE" -parse-bdsp "$BDSP_SOURCE" -parse-unbound "$UNBOUND_SOURCE" && \
echo "trainers generated at '$OUT'"
